+    private func scheduleMRPReconnect(for generation: UInt64) {
+        guard generation == mrpConnectionGeneration,
+              connectedDevice != nil,
+              currentCredentials != nil,
+              !mrpReconnectScheduled else { return }
+
+        // Preserve the existing three quick recovery attempts, then keep trying
+        // with bounded backoff instead of dropping the remembered device/session.
+        // This also lets a suspended Mac or temporarily unavailable Apple TV
+        // recover passively after wake/network restoration.
+        let nextRetry = min(mrpRetryCount + 1, Self.maxMRPRetries + 4)
+        mrpRetryCount = nextRetry
+
+        let delay: TimeInterval
+        if nextRetry <= Self.maxMRPRetries {
+            delay = 1
+        } else {
+            switch nextRetry - Self.maxMRPRetries {
+            case 1: delay = 5
+            case 2: delay = 10
+            case 3: delay = 20
+            default: delay = 30
+            }
+        }
+
+        mrpReconnectScheduled = true
+        log.info("MRP tunnel lost — retrying in \(Int(delay))s (retry \(nextRetry))")
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay) { [weak self] in
+            guard let self,
+                  self.mrpConnectionGeneration == generation else { return }
+
+            self.mrpReconnectScheduled = false
+            guard self.connectedDevice != nil,
+                  self.currentCredentials != nil else { return }
+            self.startMRPViaTunnel()
+        }
+    }
