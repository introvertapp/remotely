+    /// Update keyboard focus from Companion text-input state. A `_tiD` payload
+    /// means tvOS currently has an editable text field focused; absence of that
+    /// payload means text input is no longer active.
+    private func updateTextInputFocus(from content: OPACK.Value?) {
+        guard let content,
+              let tiData = content["_tiD"]?.dataValue,
+              let result = try? TextInputSession.decodeStartResponse(tiData) else {
+            textInputSessionUUID = nil
+            sentText = ""
+            DispatchQueue.main.async { [weak self] in
+                self?.keyboardFocused = false
+            }
+            return
+        }
+
+        textInputSessionUUID = result.sessionUUID
+        sentText = result.currentText
+        DispatchQueue.main.async { [weak self] in
+            self?.keyboardFocused = true
+        }
+    }
