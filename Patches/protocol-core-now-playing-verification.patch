+    /// Apply only conclusive idle evidence from the periodic verifier. Explicit
+    /// non-stopped playback always means the session is alive. Stopped/empty
+    /// replies can be identity-poor after an app closes, so require the same
+    /// untouched snapshot to report inactive twice before clearing it.
+    private func handleNowPlayingTeardownVerification(
+        _ state: MRP_SetStateMessage,
+        snapshot: NowPlayingVerificationSnapshot
+    ) {
+        let bundleID = bundleIdentifier(from: state)
+        let playerID = playerIdentifier(from: state)
+
+        if let bundleID, currentPlayerBundleID != nil,
+           !currentOwnerMatches(bundleID: bundleID, playerID: playerID) {
+            nowPlayingTeardownCandidate = nil
+            return
+        }
+
+        // Paused and other explicit non-stopped states are live playback. They
+        // outrank an empty/partial queue response just as Playing does.
+        if state.hasPlaybackState && state.playbackState != .stopped {
+            nowPlayingTeardownCandidate = nil
+            return
+        }
+
+        let reportsStopped = state.hasPlaybackState && state.playbackState == .stopped
+        let reportsEmptyQueue = state.hasPlaybackQueue && state.playbackQueue.contentItems.isEmpty
+        guard reportsStopped || reportsEmptyQueue else {
+            nowPlayingTeardownCandidate = nil
+            return
+        }
+
+        guard nowPlayingTeardownCandidate == snapshot else {
+            nowPlayingTeardownCandidate = snapshot
+            log.info("MRP verifier observed inactive Now Playing candidate")
+            return
+        }
+
+        nowPlayingTeardownCandidate = nil
+        log.info("MRP verifier confirmed inactive Now Playing session")
+        clearVerifiedInactivePlayback()
+    }
+
+    private func clearVerifiedInactivePlayback() {
+        let retiredBundleID = currentPlayerBundleID
+        clearCurrentPlaybackSnapshot()
+
+        if let retiredBundleID {
+            commandsByBundleID.removeValue(forKey: retiredBundleID)
+            skipIntervalsByBundleID.removeValue(forKey: retiredBundleID)
+        }
+        currentPlayerBundleID = nil
+        currentPlayerIdentifier = nil
+        explicitlySelectedBundleID = nil
+
+        DispatchQueue.main.async {
+            self.activeAppBundleID = nil
+            self.supportedCommands = []
+            self.preferredSkipIntervals = [:]
+        }
+    }
